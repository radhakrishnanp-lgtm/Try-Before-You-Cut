# Caddy gets and renews the HTTPS certificate for your domain automatically.
# Point your domain's A record (and www if you use it) at the VPS IP first.
{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 12MB
	}
	reverse_proxy app:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
