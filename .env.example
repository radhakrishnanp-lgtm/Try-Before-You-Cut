# ===================================================================
# Try-Before-You-Cut: configuration
# Copy to .env and fill in. Never commit .env.
# ===================================================================

# --- Your server -----------------------------------------------------
# Your domain (no https://). Caddy gets the HTTPS certificate for it.
DOMAIN=tryon.example.com
# Used in share links and QR codes. docker compose sets this from DOMAIN;
# set it yourself only when running without docker compose.
APP_URL=http://localhost:3000
# Long random string: signs logins, session tokens and image links.
#   openssl rand -base64 48
APP_SECRET=
# Postgres password used by docker compose.
POSTGRES_PASSWORD=
# Without docker compose, point at your own Postgres. Leave EMPTY to run
# the in-memory DEMO mode (nothing is saved).
# DATABASE_URL=postgres://tbyc:password@localhost:5432/tbyc
# Where photos/results/logos are stored (docker compose uses a volume).
# STORAGE_DIR=./storage

# --- Your admin login (platform owner) -------------------------------
ADMIN_USERNAME=admin
# Prefer a hash:  npm run hash-password -- 'your strong password'
ADMIN_PASSWORD_HASH=
# ...or a plain password (fine for a quick start, hash it later):
# ADMIN_PASSWORD=

# --- Credits ---------------------------------------------------------
# Credits charged per generated look. Failed looks are refunded.
CREDITS_PER_IMAGE=10

# --- LLM: any OpenAI-compatible API (OpenRouter by default) ----------
# Checks the photo (one face) and every result (same person, style applied).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-omni-flash
# Optional separate model for images (defaults to LLM_MODEL)
LLM_VISION_MODEL=
LLM_REASONING=1
# Force streaming on non-OpenRouter hosts
LLM_STREAM=0
# Likeness (0-1) the vision model must report for a result to be shown
LLM_IDENTITY_THRESHOLD=0.75

# --- Magnific (Freepik) MCP: image generation --------------------------
MAGNIFIC_MCP_URL=https://mcp.magnific.com
MAGNIFIC_MCP_TOKEN=
# Nano Banana 2.1, 2K, portrait
MAGNIFIC_IMAGE_MODEL=imagen-nano-banana-2-1
MAGNIFIC_RESOLUTION=2k
# 3:4 portrait; "auto" keeps each photo's own shape
MAGNIFIC_ASPECT_RATIO=3:4
# Optional: a Magnific project reference to hold the per-session folders
MAGNIFIC_PARENT_FOLDER=

# --- Provider order ----------------------------------------------------
# Tried in order if one fails. Options: magnific, gemini, flux, mock
AI_PROVIDERS=magnific
# Optional fallbacks
GEMINI_API_KEY=
REPLICATE_API_TOKEN=

# --- Optional stricter identity check (services/face-embed) -----------
FACE_SERVICE_URL=
FACE_SERVICE_TOKEN=
IDENTITY_THRESHOLD=0.45

# --- Privacy notice ------------------------------------------------------
GRIEVANCE_EMAIL=privacy@example.com

# --- Optional external cron --------------------------------------------
# Cleanup already runs inside the app every 15 minutes. Set this only if
# you also want to trigger GET /api/cron/cleanup with "Authorization: Bearer <secret>".
CRON_SECRET=
