# --- App ---------------------------------------------------------------
# Public base URL (used in share links, magic-link redirects and QR codes)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Long random string. Signs session tokens and demo media URLs.
APP_SECRET=change-me-to-a-long-random-string
# Comma-separated emails that get the platform admin console (/admin)
PLATFORM_ADMIN_EMAILS=you@example.com
# Grievance contact shown in the DPDP consent notice and privacy policy
NEXT_PUBLIC_GRIEVANCE_EMAIL=privacy@example.com

# --- Data mode ---------------------------------------------------------
# Leave the Supabase values empty to run in DEMO mode: in-memory data,
# a mock AI provider and a "demo login". Nothing persists across restarts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (any OpenAI-compatible API; OpenRouter by default) ------------
# Does the vision checks: one face in the photo, same person in every result,
# and that the requested style was actually applied.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# or OPENROUTER_API_KEY=
LLM_MODEL=qwen/qwen3.8-omni-flash
# Optional separate model for images (defaults to LLM_MODEL)
LLM_VISION_MODEL=
# Reasoning on (OpenRouter); reasoning_details are passed back unmodified
LLM_REASONING=1
# Force streaming on non-OpenRouter hosts
LLM_STREAM=0
# Likeness (0-1) the vision model must report for a result to be shown
LLM_IDENTITY_THRESHOLD=0.75
# Per-check model override, e.g. LLM_MODEL_IDENTITY_CHECK=...

# --- Magnific (Freepik) MCP: image generation ---------------------------
MAGNIFIC_MCP_URL=https://mcp.magnific.com
MAGNIFIC_MCP_TOKEN=
# Slug from images_models_list (Nano Banana 2 Lite = cheap and fast)
MAGNIFIC_IMAGE_MODEL=imagen-nano-banana-2-lite
# Optional: project reference to hold the per-session folders
MAGNIFIC_PARENT_FOLDER=

# --- AI image editing --------------------------------------------------
# Ordered provider chain; the next one is tried if one errors.
# Options: magnific, gemini, flux, mock
AI_PROVIDERS=magnific,gemini,flux
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
REPLICATE_API_TOKEN=
FLUX_MODEL=black-forest-labs/flux-kontext-pro

# --- Identity check ----------------------------------------------------
# Order: face service (if set) → LLM vision (if LLM_API_KEY) → mock (demo only).
# URL of the face-embedding service (see services/face-embed). Optional now
# that the LLM can do the check; the embedding check is stricter.
FACE_SERVICE_URL=
FACE_SERVICE_TOKEN=
# Cosine similarity (ArcFace) required between the original and result face.
IDENTITY_THRESHOLD=0.45

# --- Cron --------------------------------------------------------------
# Vercel sends this as a Bearer token to /api/cron/cleanup
CRON_SECRET=change-me

# Internal provider bake-off ONLY: skip the identity check when no face
# service is configured. Never enable for customer traffic.
# ALLOW_UNVERIFIED_RESULTS=true
